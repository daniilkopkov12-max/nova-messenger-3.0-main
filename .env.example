# Server
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173

# Database (SQLite for easy local start; switch to PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# For PostgreSQL (uncomment and configure):
# DATABASE_URL="postgresql://postgres:password@localhost:5432/nova_messenger?schema=public"

# Session / Auth
SESSION_SECRET=change-this-to-a-long-random-string-at-least-32-chars
JWT_SECRET=change-this-to-another-long-random-string

# File uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# WebRTC: TURN is recommended for reliable calls across different networks.
# Option A: Metered Open Relay TURN (free signup; verify the quota shown in your dashboard).
# In Metered dashboard, use the app host such as myapp.metered.live and its API key.
# Keep the API key in this root .env only; never use VITE_ prefixes.
METERED_APP_NAME=
METERED_API_KEY=

# Option B: Cloudflare Realtime TURN. Requires a TURN key and API token with Calls Write.
# Keep these secrets server-side only; this service may request billing setup.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# Option C: an existing TURN service (read by backend, not Vite).
# Separate multiple TURN URLs with commas.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

